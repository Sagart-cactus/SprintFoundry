{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": ["@vitest/coverage-v8"],
  "ignore": ["tests/helpers/event-factory.ts"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/*.mjs"]
    },
    "website": {
      "project": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts"]
    },
    "monitor/v4": {
      "entry": ["src/**/*"],
      "project": ["src/**/*"]
    },
    "monitor/v5": {
      "entry": ["src/**/*"],
      "project": ["src/**/*"]
    }
  }
}
