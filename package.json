{
  "name": "sprintfoundry",
  "version": "0.7.2",
  "packageManager": "pnpm@9.15.4",
  "description": "Multi-agent orchestration platform for AI-powered software development",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sprintfoundry": "dist/index.js"
  },
  "files": [
    "dist/",
    "monitor/",
    "config/platform.yaml",
    "src/agents/",
    "src/agents-codex/",
    "plugins/"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "build:website": "pnpm --filter @sprintfoundry/website build",
    "dev": "tsx src/index.ts",
    "dev:website": "pnpm --filter @sprintfoundry/website dev",
    "event-api": "tsx src/service/event-ingestion-server.ts",
    "monitor": "node monitor/server.mjs",
    "infra:up": "./scripts/dev-infra.sh up",
    "infra:down": "./scripts/dev-infra.sh down",
    "infra:reset": "./scripts/dev-infra.sh reset",
    "infra:status": "./scripts/dev-infra.sh status",
    "infra:migrate": "./scripts/dev-infra.sh migrate",
    "dev:distributed": "./scripts/dev-distributed-local.sh",
    "start": "node dist/index.js",
    "lint": "eslint . && html-validate website/index.html && pnpm typecheck && pnpm --filter @sprintfoundry/website typecheck",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"website/src/**/*.ts\" \"website/tests/**/*.ts\"",
    "format:check": "prettier --check \"website/src/**/*.ts\" \"website/tests/**/*.ts\" \"website/*.config.ts\" \"scripts/*.mjs\" eslint.config.js AGENTS.md website/README.md docs/api/openapi.yaml docs/data-handling.md \".github/**/*.{yml,md}\" .devcontainer/devcontainer.json",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "dead-code:check": "knip --include files,dependencies,unlisted,unresolved,binaries",
    "dead-code:report": "knip",
    "duplicates:check": "jscpd --config .jscpd.json src/service website/src",
    "boundaries:check": "depcruise --config .dependency-cruiser.cjs src",
    "versions:check": "syncpack lint",
    "check:changed-files": "node scripts/check-changed-files.mjs",
    "docs:validate": "node scripts/validate-agent-doc.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --pool=forks --maxWorkers=1 --no-file-parallelism",
    "profile": "node --cpu-prof --heap-prof dist/index.js",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "claude",
    "codex",
    "multi-agent",
    "software-development",
    "code-review"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sagart-cactus/sprintfoundry.git"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.47",
    "@anthropic-ai/sdk": "^0.78.0",
    "@aws-sdk/client-s3": "^3.1001.0",
    "@inquirer/prompts": "^7.0.0",
    "@kubernetes/client-node": "^1.4.0",
    "@openai/codex-sdk": "^0.104.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.57.0",
    "@opentelemetry/sdk-metrics": "^1.30.0",
    "commander": "^13.1.0",
    "pg": "^8.16.3",
    "redis": "5.11.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "~4.0.18",
    "dependency-cruiser": "^16",
    "eslint": "^10.13.0",
    "globals": "^17",
    "html-validate": "^10",
    "husky": "^9",
    "jscpd": "^4",
    "knip": "^6",
    "lint-staged": "^15",
    "prettier": "^3",
    "syncpack": "^13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "protobufjs@7": "^7.6.5",
      "@protobufjs/utf8@1": "^1.1.1",
      "fast-xml-parser@5": "^5.7.0",
      "fast-xml-builder@1": "^1.1.7",
      "ip-address@10": "^10.7.1",
      "ws@8": "^8.21.0",
      "form-data@4": "^4.0.6",
      "js-yaml@4": "^4.3.2",
      "zod@4": "^4.6.6"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
